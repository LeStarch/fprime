@ The sequence emitted a message
event SequenceMessage(message: string size 120 @< The message generated by the sequence
                     ) severity activity high format "{}"

@ The sequence emitted a message
event SequencePanic(message: string size 120 @< The message generated by the sequence
                   ) severity warning high format "{}"

@ The sequence succeeded
event SequenceSucceeded() severity activity high format "Sequence succeeded"
@ The sequence emitted a message
event SequenceFailed(status: I32) severity warning high format "Sequence failed with status: {}"